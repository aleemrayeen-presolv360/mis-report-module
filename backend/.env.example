# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# ---- Database (Postgres sit_lwms) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sit_lwms
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# ---- Local development only ----
# The host app normally sets req.user. When running this server on its own,
# put a real auth.account id here so "created by" / "generated by" work.
MIS_DEV_USER_ID=
MIS_DEV_USER_EMAIL=

# ---- Exports ----
MIS_EXPORT_DIR=./exports
MIS_EXPORT_BATCH_SIZE=5000
MIS_MAX_CONCURRENT_EXPORTS=2
MIS_EXPORT_TIMEOUT_MINUTES=60
MIS_FILE_RETENTION_DAYS=90
MIS_PREVIEW_ROWS=50
MIS_PREVIEW_TIMEOUT_SECONDS=60
# Set to false on servers that should not build files or send scheduled emails.
MIS_RUN_WORKERS=true

# ---- Email (SMTP). Leave SMTP_HOST empty to only log emails. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MIS_EMAIL_FROM=Litelo Reports <reports@litelo.ai>
MIS_EMAIL_MAX_ATTACHMENT_MB=20
